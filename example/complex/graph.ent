#!/usr/bin/env entish
# Graphs as maps of lists: a build order by topological sort, which raises on
# a cycle, and shortest paths by breadth-first search. All state is passed
# along as new values; nothing is mutated.

fn fold f acc xs { match $xs { [] => $acc; [x ...rest] => fold $f ($f $acc $x) $rest } }
fn has xs x { match $xs { [] => $false; [y ...rest] => $y == $x || (has $rest $x) } }
fn join sep xs { fold { |a x| if $a == '' { "$x" } else { "$a$sep$x" } } '' $xs }

# ---- build order

# visit adds node and everything it depends on to state[done], deps first.
# state[path] is the chain being visited; meeting a node on it is a cycle.
fn visit graph state node {
    if (has $state[done] $node) {
        $state
    } else if (has $state[path] $node) {
        let chain = join ' -> ' [...$state[path] $node]
        fail [msg: "cycle: $chain"  cycle: [...$state[path] $node]]
    } else {
        let inner = assoc path [...$state[path] $node] $state
        let after = fold { |s d| visit $graph $s $d } $inner $graph[$node]
        assoc done [...$after[done] $node] (assoc path $state[path] $after)
    }
}

fn build_order graph {
    fold { |s n| visit $graph $s $n } [done: [] path: []] (keys $graph)
}

let deps = [
    app:   ['ui' 'lib']
    ui:    ['lib' 'theme']
    lib:   ['core']
    theme: ['core']
    core:  []
]
print 'build order:' (join ', ' (build_order $deps)[done])

let cyclic = assoc core ['app'] $deps
try {
    build_order $cyclic
} catch e {
    print 'error:' $e[msg]
    print 'cycle length:' ((len $e[cycle]) - 1)
}

# ---- shortest paths

# Paths are extended one edge at a time, oldest first, so the first path
# that reaches goal is a shortest one. Emits nothing if there is none.
fn bfs graph queue seen goal {
    match $queue {
        [] => {}
        [path ...rest] => {
            let node = $path[(len $path) - 1]
            if $node == $goal {
                $path
            } else {
                let next = ...$graph[$node] |> each { if !(has $seen $it) { $it } } |> list
                let longer = ...$next |> each { [...$path $it] } |> list
                bfs $graph [...$rest ...$longer] [...$seen ...$next] $goal
            }
        }
    }
}

fn route graph from to {
    let paths = bfs $graph [[$from]] [$from] $to |> list
    match $paths {
        [p] => { let hops = (len $p) - 1; print "$from to $to:" (join ' -> ' $p) "($hops hops)" }
        []  => print "$from to $to: no route"
    }
}

let roads = [
    seoul:   ['incheon' 'suwon' 'chuncheon']
    incheon: ['seoul']
    suwon:   ['seoul' 'daejeon']
    chuncheon: ['seoul' 'gangneung']
    daejeon: ['suwon' 'daegu' 'gwangju']
    daegu:   ['daejeon' 'busan']
    gwangju: ['daejeon']
    busan:   ['daegu']
    gangneung: ['chuncheon']
    jeju:    []
]
route $roads incheon busan
route $roads gwangju gangneung
route $roads seoul jeju
