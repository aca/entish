#!/usr/bin/env entish
# Recursion and exact numbers: num is a rational, so nothing overflows or rounds.

fn fact n {
    if $n <= 1 { 1 } else { $n * (fact ($n - 1)) }
}

fn fib n {
    if $n < 2 { $n } else { (fib ($n - 1)) + (fib ($n - 2)) }
}

# Euclid
fn gcd a b {
    if $b == 0 { $a } else { gcd $b ($a % $b) }
}

print '50! =' (fact 50)
print 'fib 0..15:' (seq 0 15 | lines |> map { fib (num $it) })
print 'gcd 1071 462 =' (gcd 1071 462)
print '1/3 + 1/6 =' (1 / 3 + 1 / 6)
print '0.1 + 0.2 == 0.3:' (0.1 + 0.2 == 0.3)
print '2 ** 128 =' (2 ** 128)
