#!/usr/bin/env entish
let name = 'world'
let langs = ['go' 'bash' 'nix']
let n = len $langs
print "hello $name, $n langs"                 # hello world, 3 langs

let n = (len $langs)
print "hello $name, $n langs"                 # hello world, 3 langs

let n = (len $langs) + 1 
print "hello $name, $n langs"                 # hello world, 3 langs

