#!/usr/bin/env entish
# The systemd journal as data: one JSON object per line, streamed into
# records, matched by shape, then back to bytes for sort and uniq.

fn unit e {
    match $e {
        [_SYSTEMD_UNIT: u]     => $u
        [SYSLOG_IDENTIFIER: s] => $s
        _                      => '?'
    }
}

# warnings and errors per unit in the last 5000 entries
journalctl -o json -n 10000 --no-pager | from_json |>
    each { if (num $it[PRIORITY]) <= 3 { unit $it } } |> print | sort | uniq -c | sort -rn | head

#    787 docker.service
#     59 systemd-udevd.service
#      4 systemd-tmpfiles-clean.service
#      1 stop-zerotierone.service
#      1 init.scope

# live: the same pipeline on journalctl -f handles each entry as it arrives
# journalctl -o json -f | from_json |> each {..} |> print
